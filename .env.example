# Beeper Desktop API URL (default local endpoint)
# When deploying to Vercel, point this to a secure tunnel (e.g. Tailscale Funnel, Cloudflare Tunnel, or ngrok)
BEEPER_API_URL=http://localhost:23373

# Access token created in Beeper Desktop -> Settings -> Developers -> Create Access Token
BEEPER_ACCESS_TOKEN=

# Local server port
PORT=3000
